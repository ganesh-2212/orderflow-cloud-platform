# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-a-local-development-password>
POSTGRES_DB=orderflow_order

# Inventory Service
INVENTORY_SERVICE_URL=http://inventory-service:8082
INVENTORY_SERVICE_TIMEOUT_MS=5000

# Fulfillment Service
FULFILLMENT_SERVICE_URL=http://fulfillment-service:8083
FULFILLMENT_SERVICE_TIMEOUT_MS=5000

# Security & JWT Configuration
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRATION_MS=86400000

# Default Admin User (For initial setup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-a-local-development-password>
